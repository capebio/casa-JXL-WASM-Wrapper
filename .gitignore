.worktrees/
.epiccodereview/
tmp/
.codex-tmp/
**/__pycache__/

# flipflop timing vehicle
.flipflop/
flipflop-corpus/

# wasm-pack intermediate out-dir (the shipped RAW module is web/pkg/, copied by build-parallel-wasm.ps1)
/pkg/
# Local single-threaded RAW module for the headless P2c e2e harness
# (wasm-pack build --target web --out-dir web/pkg-st --release). Not shipped; the harness gates on it.
web/pkg-st/

# ============================================================================
# Build artifacts, dependencies, and runtime profiles
# (These were accidentally committed in the past; this .gitignore + rm --cached
#  cleans the index so future merges and clones stay lean.)
# ============================================================================

# JS / monorepo dependencies (workspaces populate these)
node_modules/

# Compiled benchmark binaries (root-level *.exe from cargo bench/example runs)
*.exe

# "Plain" measurement WASM enc builds (regenerated; not shipped)
packages/jxl-wasm/dist/*.plain.js
packages/jxl-wasm/dist/*.plain.wasm

# Rust build artifacts (Cargo target dir)
target/
.cargo-home/

# ccache compiler cache — accidentally committed (3166 files); bloated every worktree checkout (S4 hygiene)
**/.ccache/

# Prebuilt libjxl reference tooling (cjxl/djxl exes + source) — unreferenced by any build; untracked, kept on disk (S4-D5)
external/libjxlJun26/
.codex-cargo-target-*/
# Generated threaded-wasm pkg (build with tools/build-mt-wasm.sh)
pkg-mt/

# Temporary / scratch (already partially ignored; ensure all)
tmp/

# Browser / test automation profiles (Playwright, CDP, persistent contexts)
bun-chrome-*/
node-cdp-*/
bun-persistent-*/

# Agent / review / automation worktrees and scratch
.claude/worktrees/
.epiccodereview/
docs/superpowers/          # planning artifacts from superpowers/ skill (ephemeral; see docs/references/historical/)

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Logs and error dumps
*.log
debug.log
build errors*.log
build errors.run.log

# Python
**/__pycache__/
*.py[cod]
*$py.class

# Vendored sources (jpegxl-rs vendored, cargo vendor, etc.)
vendor/*
# Exception: jpegxl-src build-glue crate is patched in-tree ([patch.crates-io] in
# Cargo.toml) to force MSVC /O2 on the libjxl release build (without it, libjxl 0.11.x
# builds unoptimized → ~30x slower encode/decode). Tracked so the patch resolves on
# clone/CI. Glue only (~35K); libjxl source is the external/libjxl submodule.
!vendor/jpegxl-src/

# Benchmark / experimental output (generated by various benchmark scripts)
benchmark/runs/
benchmark/option-matrix*.mjs
benchmark/inspect-image.mjs
benchmark/matrix-view.mjs
docs/TAURI_OPTION_MATRIX_BENCHMARK.md
docs/outputs/
docs/paper-build/
test-images/

# One-off correlation matrix experiments
web/jxl-correlation-matrix.html
web/jxl-correlation-matrix.js
.worktrees/

# Research papers (large PDFs, ~57MB; kept on disk, not tracked to keep clones lean)
Papers/

# Generated PGO / test-corpus images — regenerate via
# packages/jxl-test-corpus/scripts/generate-pgo-fixtures.mjs.
# Full-res .ppm are ~30-70MB each (864MB this session); kept on disk, not tracked, to keep clones lean.
packages/jxl-test-corpus/**/*.ppm

pkg-fbench-*/
docs/outputs/codec-paper/corpus/

# ============================================================================
# S4 hygiene (2026-07-07): scratch dirs/files that were accidentally committed
# before an ignore rule existed. Removed from the index this pass; these patterns
# stop them re-entering. All are regenerable build output or tool scratch.
# ============================================================================
# Alternate Cargo target dirs used by codex/agent runs (root `target/` already
# ignored; these sibling variants slipped through).
target-codex*/
# EpicCodeReview output written to a literal "undefined/" path when its output-dir
# variable was unset (a tool bug). Real review artifacts live in docs/ + root *.md.
/undefined/
# flipflop journal output files dropped at repo root (the .flipflop/ dir is already
# ignored; these are the same generated TOON journals with a different name shape).
.flipflop-*-out.txt

# S5 golden workflow: large binary pixel buffers generated by golden-check.mjs --update.
# Not committed (each is ~40-82 MB RGBA8); regenerate locally before running checks.
docs/golden-buffers/*.rgba
pkg-fable/

# calibration demo output (regenerable)
crates/raw-pipeline/calibration-samples/

# secrets — API keys for AI-ID services etc. (never commit)
.env
.env.local

+    #[test]
+    fn process_dual_simd_matches_separate_passes() {
+        // The fused dual-output kernel must be BYTE-EXACT (diff == 0) vs running
+        // process_into_simd (u8) and process_16bit_simd (u16) separately: it shares the
+        // identical gather + matvec + clamp and only differs in which post-LUT it indexes.
+        let mut params = PipelineParams::default_olympus();
+        params.vibrance = 0.0;
+        assert!(!derive_tone_inputs(&params).perceptual_constancy);
+        // n deliberately NOT a multiple of BLK(2048) so the ragged tail block is exercised.
+        let n = 2_000_001usize;
+        let rgb16: Vec<u16> = (0..n * 3)
+            .map(|i| (i.wrapping_mul(2654435761) & 0x3fff) as u16)
+            .collect();
+        let mut ref8 = vec![0u8; n * 3];
+        process_into_simd(&rgb16, &params, &mut ref8);
+        let ref16 = process_16bit_simd(&rgb16, &params);
+        let mut out8 = vec![0u8; n * 3];
+        let mut out16 = vec![0u16; n * 3];
+        process_dual_simd(&rgb16, &params, &mut out8, &mut out16);
+        assert_eq!(out8, ref8, "dual u8 output diverged from process_into_simd");
+        assert_eq!(out16, ref16, "dual u16 output diverged from process_16bit_simd");
+    }

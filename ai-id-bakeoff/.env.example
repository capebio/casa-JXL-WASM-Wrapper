# Copy to .env and fill in. .env is gitignored.

# Pl@ntNet — free key, 500 IDs/day. Register: https://my.plantnet.org/
# Docs: https://my.plantnet.org/doc/getting-started/introduction
PLANTNET_API_KEY=

# iNaturalist — OAuth JWT (~24h lifetime). Get it while logged in at:
# https://www.inaturalist.org/users/api_token   (copy the "api_token" value)
INAT_API_TOKEN=

# (Legacy aliases PLANTNET_KEY / INAT_TOKEN are also accepted.)

# Google Lens needs no key (headful Playwright browser).

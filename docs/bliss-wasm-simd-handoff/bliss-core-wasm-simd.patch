+//! WASM `v128` (128-bit SIMD) rANS decode — the browser sibling of `rans_avx2`.
+//! 16-lane stream, 4×`v128` (4 u32 lanes each), bit-identical to the scalar decoder in `rans.rs`
+//! (asserted by roundtrip tests). Same packed LUT [sym:8 | freq-1:12 | start:12] per 12-bit slot.
+//!
+//! WASM SIMD has no gather → `plut[c]` is emulated per lane (extract → scalar L1 load → build).
+//! Renorm reads are sequential/lane-ascending (must match `rans::decode_lanes` word order exactly),
+//! so they run as a scalar per-lane pass over the ≤16 active lanes — simple and provably correct.
+//! Decode uses only 32-bit math (`i32x4_mul` low 32 = exact). The ENCODER (`encode16l_v128`, below)
+//! also lives here: its Lemire division uses the widening 32×32→64 multiply (`u64x2_extmul_*`).
+#![allow(unsafe_op_in_unsafe_fn)]
+use crate::rans::{Table, PROB_BITS};
+use core::arch::wasm32::*;
+
+const RANS_L: u32 = 1 << 16;
+
+/// Packed LUT: one u32 per 12-bit slot = [sym:8 | (freq-1):12 | start:12]. Same layout as
+/// `rans_avx2::packed_lut` (that one is x86-gated; this is the wasm-visible copy).
+pub fn packed_lut(t: &Table) -> Vec<u32> {
+    let mut lut = vec![0u32; 1 << PROB_BITS];
+    for s in 0..256 {
+        let f = t.freq[s] as u32;
+        if f == 0 {
+            continue;
+        }
+        let v = ((s as u32) << 24) | ((f - 1) << 12) | t.start[s];
+        for slot in t.start[s]..t.start[s + 1] {
+            lut[slot as usize] = v;
+        }
+    }
+    lut
+}
+
+// ================= 16-lane rANS ENCODE (v128) — mirror of rans_avx2::encode16l =================
+// The encoder walks symbols in reverse (lanes descending within a step); one global reversal makes
+// the decoder read forward. Lemire division q = (x*M)>>64 uses the widening 32×32→64 multiply
+// (`u64x2_extmul_*`), 2 lanes at a time. Bit-identical to `rans::encode_lanes(sym, t, 16)`.
+
+/// SoA encode tables: fs_st = [freq:16 | start:16]; mlo/mhi = the two halves of M = ⌊2^64/f⌋+1 (0 if f≤1).
+#[derive(Clone)]
+pub struct EncTables {
+    pub fs_st: Vec<u32>,
+    pub mlo: Vec<u32>,
+    pub mhi: Vec<u32>,
+}
+
+pub fn enc_tables(t: &Table) -> EncTables {
+    let mut fs_st = vec![0u32; 256];
+    let mut mlo = vec![0u32; 256];
+    let mut mhi = vec![0u32; 256];
+    for s in 0..256 {
+        let f = t.freq[s] as u32;
+        fs_st[s] = (f << 16) | t.start[s];
+        let m: u64 = if f <= 1 { 0 } else { (u64::MAX / f as u64) + 1 };
+        mlo[s] = m as u32;
+        mhi[s] = (m >> 32) as u32;
+    }
+    EncTables { fs_st, mlo, mhi }
+}
+
+#[inline]
+unsafe fn scalar_step_enc(s: u8, x: &mut u32, t: &Table, outp: *mut u16, opos: &mut usize) {
+    let si = s as usize;
+    let fs = t.freq[si] as u32;
+    if *x >= (fs << 20) {
+        *outp.add(*opos) = (*x & 0xFFFF) as u16;
+        *opos += 1;
+        *x >>= 16;
+    }
+    let m: u64 = if fs <= 1 { 0 } else { (u64::MAX / fs as u64) + 1 };
+    let q = if m == 0 { *x } else { ((*x as u128 * m as u128) >> 64) as u32 };
+    let r = *x - q * fs;
+    *x = (q << PROB_BITS) + r + t.start[si];
+}
+
+/// q = ⌊x·M / 2^64⌋ for 4 u32 lanes, M per-lane u64 (mhi:mlo). Uses `extmul` (32×32→64), 2 lanes/op.
+#[inline]
+#[target_feature(enable = "simd128")]
+unsafe fn lemire_q_v128(x: v128, mlo: v128, mhi: v128) -> v128 {
+    // lanes 0,1 via extmul_low ; lanes 2,3 via extmul_high
+    let hi1_lo = u64x2_shr(u64x2_extmul_low_u32x4(x, mlo), 32);
+    let hi1_hi = u64x2_shr(u64x2_extmul_high_u32x4(x, mlo), 32);
+    let sum_lo = i64x2_add(hi1_lo, u64x2_extmul_low_u32x4(x, mhi));
+    let sum_hi = i64x2_add(hi1_hi, u64x2_extmul_high_u32x4(x, mhi));
+    let q_lo = u64x2_shr(sum_lo, 32); // q0 in low32 of lane0, q1 in low32 of lane1
+    let q_hi = u64x2_shr(sum_hi, 32); // q2, q3
+    // pack low32 of each i64 lane → u32x4 [q0,q1,q2,q3]
+    i8x16_shuffle::<0, 1, 2, 3, 8, 9, 10, 11, 16, 17, 18, 19, 24, 25, 26, 27>(q_lo, q_hi)
+}
+
+/// Encode into a 16-lane stream; bit-identical to `rans::encode_lanes(sym, t, 16)`.
+#[target_feature(enable = "simd128")]
+pub unsafe fn encode16l_v128(sym: &[u8], t: &Table, et: &EncTables) -> Vec<u16> {
+    let n = sym.len();
+    let mut x = [RANS_L; 16];
+    let mut out: Vec<u16> = Vec::with_capacity(n + 2 * 16 + 64);
+    let outp = out.as_mut_ptr();
+    let mut opos = 0usize;
+    let steps = n.div_ceil(16);
+    // first (possibly partial) reverse step scalar — matches encode16l
+    let mut first_full = steps;
+    if steps * 16 != n || steps == 0 {
+        first_full = steps.saturating_sub(1);
+        if steps > 0 {
+            let step = steps - 1;
+            for j in (0..16).rev() {
+                let idx = step * 16 + j;
+                if idx >= n {
+                    continue;
+                }
+                scalar_step_enc(sym[idx], &mut x[j], t, outp, &mut opos);
+            }
+        }
+    }
+    let mut xr = [
+        v128_load(x.as_ptr() as *const v128),
+        v128_load(x.as_ptr().add(4) as *const v128),
+        v128_load(x.as_ptr().add(8) as *const v128),
+        v128_load(x.as_ptr().add(12) as *const v128),
+    ];
+    let m16 = u32x4_splat(0xFFFF);
+    let one = u32x4_splat(1);
+    let (fsp, mlop, mhip, symp) = (et.fs_st.as_ptr(), et.mlo.as_ptr(), et.mhi.as_ptr(), sym.as_ptr());
+
+    for step in (0..first_full).rev() {
+        let mut freq = [u32x4_splat(0); 4];
+        let mut start = [u32x4_splat(0); 4];
+        let mut mlo = [u32x4_splat(0); 4];
+        let mut mhi = [u32x4_splat(0); 4];
+        let mut ge = [u32x4_splat(0); 4];
+        for r in 0..4 {
+            let base = step * 16 + r * 4;
+            let s0 = *symp.add(base) as usize;
+            let s1 = *symp.add(base + 1) as usize;
+            let s2 = *symp.add(base + 2) as usize;
+            let s3 = *symp.add(base + 3) as usize;
+            let fs = u32x4(*fsp.add(s0), *fsp.add(s1), *fsp.add(s2), *fsp.add(s3));
+            let f = u32x4_shr(fs, 16);
+            freq[r] = f;
+            start[r] = v128_and(fs, m16);
+            mlo[r] = u32x4(*mlop.add(s0), *mlop.add(s1), *mlop.add(s2), *mlop.add(s3));
+            mhi[r] = u32x4(*mhip.add(s0), *mhip.add(s1), *mhip.add(s2), *mhip.add(s3));
+            // renorm needed: unsigned x >= xmax, xmax = freq << 20
+            ge[r] = u32x4_ge(xr[r], u32x4_shl(f, 20));
+        }
+        // emit low16 of masked lanes, DESC lane order: lanes 15..0 = reg3, reg2, reg1, reg0
+        for r in (0..4).rev() {
+            let m = u32x4_bitmask(ge[r]);
+            if m != 0 {
+                let xv = xr[r];
+                let l = [
+                    u32x4_extract_lane::<0>(xv),
+                    u32x4_extract_lane::<1>(xv),
+                    u32x4_extract_lane::<2>(xv),
+                    u32x4_extract_lane::<3>(xv),
+                ];
+                for lane in (0..4).rev() {
+                    if (m >> lane) & 1 != 0 {
+                        *outp.add(opos) = (l[lane] & 0xFFFF) as u16;
+                        opos += 1;
+                    }
+                }
+                xr[r] = v128_bitselect(u32x4_shr(xv, 16), xv, ge[r]); // shift masked lanes
+            }
+        }
+        // Lemire update all regs: q=(x*M)>>64 (q=x when freq==1); x = (q<<12) + (x - q*freq) + start
+        for r in 0..4 {
+            let q0 = lemire_q_v128(xr[r], mlo[r], mhi[r]);
+            let q = v128_bitselect(xr[r], q0, u32x4_eq(freq[r], one));
+            let rr = u32x4_sub(xr[r], i32x4_mul(q, freq[r]));
+            xr[r] = u32x4_add(u32x4_add(u32x4_shl(q, PROB_BITS), rr), start[r]);
+        }
+    }
+    v128_store(x.as_mut_ptr() as *mut v128, xr[0]);
+    v128_store(x.as_mut_ptr().add(4) as *mut v128, xr[1]);
+    v128_store(x.as_mut_ptr().add(8) as *mut v128, xr[2]);
+    v128_store(x.as_mut_ptr().add(12) as *mut v128, xr[3]);
+    for j in (0..16).rev() {
+        *outp.add(opos) = (x[j] & 0xFFFF) as u16;
+        *outp.add(opos + 1) = (x[j] >> 16) as u16;
+        opos += 2;
+    }
+    out.set_len(opos);
+    out.reverse();
+    out
+}
+
+/// Decode `n` symbols from a 16-lane stream. `words` must have >= 16 u16 of readable padding at the
+/// end (renorm look-ahead). Bit-identical to `rans::decode_lanes(words, n, t, lut, 16)`.
+#[target_feature(enable = "simd128")]
+pub unsafe fn decode16l_v128(words: &[u16], n: usize, plut: &[u32], out: &mut [u8]) {
+    let mut pos = 0usize;
+    let mut x = [0u32; 16];
+    for lane in &mut x {
+        *lane = ((words[pos] as u32) << 16) | words[pos + 1] as u32;
+        pos += 2;
+    }
+    let full_steps = n / 16;
+    let mut xr = [
+        v128_load(x.as_ptr() as *const v128),
+        v128_load(x.as_ptr().add(4) as *const v128),
+        v128_load(x.as_ptr().add(8) as *const v128),
+        v128_load(x.as_ptr().add(12) as *const v128),
+    ];
+    let mask12 = u32x4_splat(0xFFF);
+    let one = u32x4_splat(1);
+    let plutp = plut.as_ptr();
+    let outp = out.as_mut_ptr();
+
+    for step in 0..full_steps {
+        for r in 0..4 {
+            let xv = xr[r];
+            let c = v128_and(xv, mask12);
+            // emulate gather plut[c] for the 4 lanes (LUT is 16 KB, L1-resident)
+            let c0 = u32x4_extract_lane::<0>(c) as usize;
+            let c1 = u32x4_extract_lane::<1>(c) as usize;
+            let c2 = u32x4_extract_lane::<2>(c) as usize;
+            let c3 = u32x4_extract_lane::<3>(c) as usize;
+            let lv = u32x4(
+                *plutp.add(c0),
+                *plutp.add(c1),
+                *plutp.add(c2),
+                *plutp.add(c3),
+            );
+            // symbols = lv >> 24, one byte per lane
+            let base = step * 16 + r * 4;
+            *outp.add(base) = (u32x4_extract_lane::<0>(lv) >> 24) as u8;
+            *outp.add(base + 1) = (u32x4_extract_lane::<1>(lv) >> 24) as u8;
+            *outp.add(base + 2) = (u32x4_extract_lane::<2>(lv) >> 24) as u8;
+            *outp.add(base + 3) = (u32x4_extract_lane::<3>(lv) >> 24) as u8;
+            // x = freq*(x>>12) + c - start ; freq = ((lv>>12)&0xFFF)+1 ; start = lv&0xFFF
+            let freq = u32x4_add(v128_and(u32x4_shr(lv, 12), mask12), one);
+            let start = v128_and(lv, mask12);
+            let xq = u32x4_shr(xv, PROB_BITS);
+            xr[r] = u32x4_sub(u32x4_add(i32x4_mul(freq, xq), c), start);
+        }
+        // renorm: lane-ascending (matches scalar word order). Register-resident — extract/merge/
+        // replace only the lanes that fire, no per-step memory round-trip. Skip regs with no active
+        // lane via the i32x4 need-mask (bitmask).
+        macro_rules! renorm_reg {
+            ($r:expr) => {{
+                let xv = xr[$r];
+                // need = (x >> 16) == 0  (unsigned x < 2^16)
+                let need = u32x4_eq(u32x4_shr(xv, 16), u32x4_splat(0));
+                if u32x4_bitmask(need) != 0 {
+                    let mut l0 = u32x4_extract_lane::<0>(xv);
+                    let mut l1 = u32x4_extract_lane::<1>(xv);
+                    let mut l2 = u32x4_extract_lane::<2>(xv);
+                    let mut l3 = u32x4_extract_lane::<3>(xv);
+                    if l0 < RANS_L { l0 = (l0 << 16) | words[pos] as u32; pos += 1; }
+                    if l1 < RANS_L { l1 = (l1 << 16) | words[pos] as u32; pos += 1; }
+                    if l2 < RANS_L { l2 = (l2 << 16) | words[pos] as u32; pos += 1; }
+                    if l3 < RANS_L { l3 = (l3 << 16) | words[pos] as u32; pos += 1; }
+                    xr[$r] = u32x4(l0, l1, l2, l3);
+                }
+            }};
+        }
+        renorm_reg!(0);
+        renorm_reg!(1);
+        renorm_reg!(2);
+        renorm_reg!(3);
+    }
+
+    // recover scalar state for the tail
+    v128_store(x.as_mut_ptr() as *mut v128, xr[0]);
+    v128_store(x.as_mut_ptr().add(4) as *mut v128, xr[1]);
+    v128_store(x.as_mut_ptr().add(8) as *mut v128, xr[2]);
+    v128_store(x.as_mut_ptr().add(12) as *mut v128, xr[3]);
+    for idx in full_steps * 16..n {
+        let j = idx % 16;
+        let c = x[j] & ((1 << PROB_BITS) - 1);
+        let v = plut[c as usize];
+        out[idx] = (v >> 24) as u8;
+        let f = ((v >> 12) & 0xFFF) + 1;
+        let st = v & 0xFFF;
+        x[j] = f * (x[j] >> PROB_BITS) + c - st;
+        if x[j] < RANS_L {
+            x[j] = (x[j] << 16) | words[pos] as u32;
+            pos += 1;
+        }
+    }
+}

+#[cfg(test)]
+mod count_tests {
+    /// Validates the v128 count algorithm's bit-logic portably: a 16-bit lane bitmask masked by
+    /// 0x5555 (even lanes) / 0xAAAA (odd lanes) and popcounted must equal the scalar per[phase][ctx]
+    /// count. The wasm intrinsic `u8x16_bitmask(u8x16_eq(v,k))` produces exactly this `bm`.
+    #[test]
+    fn count_ctx_bitmask_matches_scalar() {
+        for len in [0usize, 1, 15, 16, 17, 31, 100, 257] {
+            let row: Vec<u8> = (0..len).map(|i| ((i * 7 + i / 3) % 4) as u8).collect();
+            let mut scalar = [[0usize; 4]; 2];
+            for j in 0..len {
+                scalar[j & 1][row[j] as usize] += 1;
+            }
+            let mut bm_count = [[0usize; 4]; 2];
+            let mut j = 0usize;
+            while j + 16 <= len {
+                for k in 0..4u8 {
+                    let mut bm = 0u16;
+                    for lane in 0..16 {
+                        if row[j + lane] == k {
+                            bm |= 1 << lane;
+                        }
+                    }
+                    bm_count[0][k as usize] += (bm & 0x5555).count_ones() as usize;
+                    bm_count[1][k as usize] += (bm & 0xAAAA).count_ones() as usize;
+                }
+                j += 16;
+            }
+            while j < len {
+                bm_count[j & 1][row[j] as usize] += 1;
+                j += 1;
+            }
+            assert_eq!(scalar, bm_count, "len={len}");
+        }
+    }
+}
